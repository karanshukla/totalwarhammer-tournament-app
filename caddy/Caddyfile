# global options
{
    admin off
    persist_config off
    auto_https off
    log {
        format json
    }
    servers {
        trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 172.64.0.0/13 104.16.0.0/13 104.24.0.0/14 162.158.0.0/15 198.41.128.0/17 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

(lb_settings) {
    lb_policy round_robin
    lb_retries 100
    lb_try_duration 10s
    lb_try_interval 250ms
}

(passive_health_checks) {
    fail_duration 60s
    max_fails 300
    unhealthy_latency 5s
    unhealthy_request_count 200
}

# Railway terminates TLS at its edge and Caddy listens on plain HTTP
# (auto_https off), so Caddy reports X-Forwarded-Proto: http unless the hop it
# received the request from is a trusted proxy — which Railway's edge is not.
# express-session silently drops a `secure` session cookie when it sees any
# scheme but https, so every login succeeded server-side and then 401'd on the
# next request. The public origin is https-only, so https is the true scheme.
(forwarded_scheme) {
    header_up X-Forwarded-Proto https
}

:{$PORT} {
    log {
        format json
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "credentialless"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; worker-src 'none'; frame-src 'none'; manifest-src 'self'; media-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"
        -Last-Modified
    }

    @html {
        not path /assets/*
        not path /user /user/* /auth /auth/* /guest /guest/* /password-reset /password-reset/* /tournament /tournament/* /match /match/* /stats /stats/*
        not path /socket.io*
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    @backend path /user /user/* /auth /auth/* /guest /guest/* /password-reset /password-reset/* /tournament /tournament/* /match /match/* /stats /stats/* /socket.io*
    header @backend Cache-Control "no-store, no-cache, must-revalidate"

    # Some backend paths (e.g. /tournament/:id) collide with SPA routes of the same
    # shape. Sec-Fetch-Mode:navigate is set by the browser for real page loads/refreshes
    # and can't be spoofed by client JS, so it reliably tells a hard navigation (-> SPA
    # shell) apart from a same-path fetch() call (-> backend JSON).
    @backend_route {
        not header Sec-Fetch-Mode navigate
        path /user /user/* /auth /auth/* /guest /guest/* /password-reset /password-reset/* /tournament /tournament/* /match /match/* /stats /stats/* /socket.io*
    }

    @hashed_assets path_regexp /assets/.*\.[A-Za-z0-9_-]+\.(js|css|woff2?)$
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    handle /socket.io* {
        reverse_proxy {
            dynamic a {
                name {$BACKEND_DOMAIN}
                port {$BACKEND_PORT}
                refresh 1s
                dial_timeout 30s
                versions ipv4 ipv6
            }
            header_up Host {upstream_hostport}
            import forwarded_scheme
            flush_interval -1
            transport http {
                versions 1.1
            }
        }
    }

    handle @backend_route {
        reverse_proxy {
            dynamic a {
                name {$BACKEND_DOMAIN}
                port {$BACKEND_PORT}
                refresh 1s
                dial_timeout 30s
                versions ipv4 ipv6
            }
            import lb_settings
            import passive_health_checks
            header_up Host {upstream_hostport}
            import forwarded_scheme
        }
    }

    handle {
        reverse_proxy {
            dynamic a {
                name {$FRONTEND_DOMAIN}
                port {$FRONTEND_PORT}
                refresh 1s
                dial_timeout 30s
                versions ipv4 ipv6
            }
            import lb_settings
            import passive_health_checks
            header_up Host {upstream_hostport}
            import forwarded_scheme
        }
    }
}