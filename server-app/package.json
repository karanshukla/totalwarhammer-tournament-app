{
  "name": "totalwarhammer-tournament-app",
  "version": "1.0.0",
  "description": "Tournament application for Total War: Warhammer",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"app.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"app.js\"",
    "test": "node --experimental-vm-modules --experimental-test-module-mocks --test",
    "test:watch": "node --experimental-vm-modules --experimental-test-module-mocks --test --watch"
  },
  "dependencies": {
    "@axiomhq/winston": "^1.7.0",
    "@socket.io/mongo-adapter": "^0.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "connect-mongodb-session": "^5.0.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.16.0",
    "mongoose": "^9.7.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "readable-stream": "^3.6.2",
    "redis": "^6.0.0",
    "resend": "^6.14.0",
    "socket.io": "^4.8.3",
    "tournament-pairings": "^2.0.1",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4"
  }
}
