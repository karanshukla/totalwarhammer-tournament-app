# docker-compose environment — copy to .env and fill in values
# Secrets (required — use strong random strings in production)
SESSION_SECRET=replace_with_strong_random_secret
CSRF_SECRET=replace_with_strong_random_secret

# Email sending via Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here

# URLs (set to your domain in production, leave as-is for local Docker)
CLIENT_URL=http://localhost
BASE_URL=http://localhost
