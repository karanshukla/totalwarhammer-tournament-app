{
  "name": "totalwarhammer-tournament-app",
  "version": "1.0.0",
  "private": true,
  "description": "Total War: Warhammer Tournament Application",
  "workspaces": [
    "client-app",
    "server-app"
  ],
  "scripts": {
    "install:all": "npm install",
    "install:client": "npm install --workspace=client-app",
    "install:server": "npm install --workspace=server-app",
    "dev:client": "npm run dev --workspace=client-app",
    "dev:server": "npm run dev --workspace=server-app",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test --workspace=client-app",
    "test:server": "npm run test --workspace=server-app",
    "lint": "npm run lint --workspace=client-app && npm run lint --workspace=server-app",
    "lint:fix": "npm run lint:fix --workspace=client-app && npm run lint:fix --workspace=server-app",
    "format": "npm run format --workspace=client-app && npm run format --workspace=server-app",
    "format:check": "npm run format:check --workspace=client-app && npm run format:check --workspace=server-app",
    "e2e:up": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml up -d --build",
    "e2e:down": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml down --volumes --remove-orphans",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/playwright-report",
    "test:e2e:typecheck": "tsc -p tests/e2e/tsconfig.json"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "@exodus/bytes": "^1.15.0",
    "shell-quote": "^1.9.0",
    "brace-expansion": "^5.0.9",
    "vite": {
      "postcss": "^8.5.18"
    }
  }
}
